# Optional knobs; nothing here is a secret and every value has a default.
# Threads used by the OpenMP CPU backend (default: all cores)
OMP_NUM_THREADS=4
# Google Benchmark minimum time per case, seconds (scripts/run_benchmarks.py --min-time)
MINIFFTDX_BENCH_MIN_TIME=0.2
# Directory with NumPy reference vectors (set automatically by ctest)
# MINIFFTDX_REFDIR=build/numpy_ref
